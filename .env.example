# Kero — env vars (SPEC v3 §13). Copie para .env.local e preencha.
# .env.local NUNCA vai para o git.

# URL pública do Supabase
NEXT_PUBLIC_SUPABASE_URL=https://xyz.supabase.co

# Key anônima do Supabase (browser)
NEXT_PUBLIC_SUPABASE_ANON_KEY=anon-key

# Key de serviço do Supabase — SERVER-SIDE ONLY (nunca no browser, nunca no git)
SUPABASE_SERVICE_ROLE_KEY=service-role-key

# Rotação do salt diário (true = cron atualiza daily_salt 00:00 America/Manaus)
DAILY_SALT_ROTATION_ENABLED=true

# Nome da aplicação (títulos, etc.)
NEXT_PUBLIC_APP_NAME=Kero

# Base pública do app — monta o link do cardápio que a IA envia ao cliente
NEXT_PUBLIC_APP_URL=http://localhost:3000

# IA do WhatsApp — instância WAHA. SERVER-SIDE ONLY (a API key nunca vai pro browser)
WAHA_URL=http://localhost:3000
WAHA_API_KEY=troque-pela-chave-da-sua-instancia

# Webhook do n8n que o WAHA chama a cada mensagem.
# Path é o do workflow "Kero IA WhatsApp" (n8n → WAHA message → path kero-waha).
# O workflow precisa estar ATIVADO no n8n para essa URL responder.
WHATSAPP_WEBHOOK_URL=http://localhost:5678/webhook/kero-waha
